// hs op unattended: keep locally changed config files on every upgrade.
// Hestia and hs rewrite php.ini, php-fpm.conf and the like; when a package
// ships a new version of such a file, dpkg would ask, and unattended-upgrades
// skips the package instead ("has conffile prompt and needs to be upgraded
// manually"). web1 2026-10-21: php8.3-fpm 8.3.30 -> 8.3.35 skipped that way,
// so every php8.3-* package stayed behind. With --force-confold unattended-
// upgrades does not hold such packages back (dpkg_conffile_prompt) and dpkg
// keeps the local file; --force-confdef takes the new file where nothing was
// changed locally. hs op updates-apply runs apt with the same options.
// This applies to manual apt runs too: no config-file questions, local wins.
Dpkg::Options {
        "--force-confdef";
        "--force-confold";
};

// One dpkg run instead of many small ones. With the default (MinimalSteps
// "true") alavus's PHP round on 2026-10-21 restarted php8.3-fpm six times in
// 51 s — every extension (igbinary, redis, apcu, imagick) was its own step —
// and the live site answered 503 to 8 of 59 requests. Minimal steps only exist
// so a shutdown can interrupt the run; the run is at 01:00 UTC.
Unattended-Upgrade::MinimalSteps "false";
